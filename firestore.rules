rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() && request.auth.token.role == 'staff';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isStaffOrAdmin() {
      return isStaff() || isAdmin();
    }

    // Products — public read, admin write only
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders — no direct client write; staff/admin read only
    match /orders/{orderId} {
      allow read: if isStaffOrAdmin();
      allow write: if false; // All writes via Cloud Functions
    }

    // Order items — staff/admin read only
    match /order_items/{itemId} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
    }

    // Payment proofs — staff/admin read only
    match /payment_proofs/{proofId} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
    }

    // Pickup slots — public read, admin write
    match /pickup_slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users (staff/admin accounts) — admin manages, staff reads own
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Audit log — admin read only, no client writes
    match /audit_log/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
