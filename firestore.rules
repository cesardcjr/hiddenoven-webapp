rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function isStaff() {
      return isAuthenticated() && request.auth.token.role == 'staff';
    }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    function isStaffOrAdmin() {
      return isStaff() || isAdmin();
    }

    // Products — public read, admin write only
    match /products/{productId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Orders — no direct client write; staff/admin read only
    match /orders/{orderId} {
      allow read:  if isStaffOrAdmin();
      allow write: if false;
    }

    // Order items — staff/admin read only
    match /order_items/{itemId} {
      allow read:  if isStaffOrAdmin();
      allow write: if false;
    }

    // Payment proofs — staff/admin read only
    match /payment_proofs/{proofId} {
      allow read:  if isStaffOrAdmin();
      allow write: if false;
    }

    match /payment_modes/{modeId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Pickup time configs — public read, admin write only
    match /pickup_time_configs/{configId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Legacy pickup_slots (kept for backward compat) — public read, admin write
    match /pickup_slots/{slotId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Users — admin manages, user reads own
    match /users/{uid} {
      allow read:  if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Audit log — admin read only, no client writes
    match /audit_log/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Notifications — staff and admin read only, no client writes
    match /notifications/{notifId} {
      allow read:  if isStaffOrAdmin();
      allow write: if false;
    }
  }
}
