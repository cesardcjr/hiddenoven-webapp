# ─── Firebase Client SDK (frontend) ──────────────────────────────────────────
# Copy this file to .env.local and fill in your values from Firebase Console
# Project Settings → General → Your apps → Web app → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── API Base URL ─────────────────────────────────────────────────────────────
# Development (Firebase Emulator):
# VITE_API_BASE_URL=http://localhost:5001/<YOUR_PROJECT_ID>/us-central1/api
#
# Production (after deploying Cloud Functions):
# VITE_API_BASE_URL=https://us-central1-<YOUR_PROJECT_ID>.cloudfunctions.net/api

VITE_API_BASE_URL=

# ─── Emulator flag ────────────────────────────────────────────────────────────
# Set to "true" during local development to connect to Firebase Emulator Suite
# Set to "false" (or remove) for staging and production

VITE_USE_EMULATORS=true
